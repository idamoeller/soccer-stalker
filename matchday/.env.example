# Matchday scraper config. Copy this to `.env` and fill in the secret.
# The real .env stays on your Mac only (it is gitignored) -- never commit it.

# Supabase project (URL is not secret; the KEY is your sb_secret_ service key).
SUPABASE_URL=https://hcepmsqsxsdhjgxguwqc.supabase.co
SUPABASE_KEY=

# ntfy topic to push score alerts to (subscribe to it in the ntfy app on your phone).
NTFY_TOPIC=soccer-9k3f7q-idamoeller

# --- optional tuning (sensible defaults; leave blank unless you want to change) ---
# How wide a window around kickoff counts as "check this game now" (hours).
# LOOKBACK_HOURS=5
# LOOKAHEAD_HOURS=2
# Warn if the saved cookie is older than this many hours.
# COOKIE_MAX_AGE_HOURS=30
# Comma-separated gotSport event ids to warm the cookie against (else auto/fallback).
# WARMUP_EVENT_IDS=
